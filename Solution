import java.util.*;
class Solution {
    public int maxProduct(int[] nums) {
        int num1 = 0;
        int num2 = 0;
        int d = nums.length;
        for (int i = 0; i < d; i++) {
            num1 = Math.max(num1, nums[i]);
        }
        int found = 0;
        for (int i = 0; i < d; i++) {
            if (nums[i] == num1 && found==0) {
                nums[i] = 0;
                found = 1;
            }
        }
        for (int i = 0; i < d; i++) {//
            num2 = Math.max(num2, nums[i]);
        }

        return (num1 - 1) * (num2 - 1);
    }
}
